# Environment Configuration Example
# Copy this file to .env and customize values for your local environment

# Flask Server Configuration
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_SECRET_KEY=replace-with-a-secure-jwt-secret-key-at-least-32-chars
PORT=5000

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=root
MYSQL_PASSWORD=root123

# MongoDB Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=ecommerce_nosql

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Initial Admin Seeding Configuration
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@ecommerce.com
ADMIN_PASSWORD=AdminPass@123
ADMIN_PHONE=+1-800-555-0199
